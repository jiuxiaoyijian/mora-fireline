{
  "name": "mora-fireline",
  "private": true,
  "version": "0.2.0-dev.3",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/sim/*.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:perf": "node --experimental-strip-types --test tests/performance.test.ts && node --experimental-strip-types scripts/benchmark.ts",
    "check": "npm test && npm run test:perf && npm run build"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "typescript": "~5.9.3",
    "vite": "8.3.0"
  }
}
